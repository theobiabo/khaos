{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*", "pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**", "index.js", "index.d.ts", "*.node"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["build", "^test"],
      "outputs": []
    }
  }
}
