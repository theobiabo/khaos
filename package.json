{
  "name": "khaos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "cargo build -p khaos_core --release && turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "cargo fmt --all && prettier --write .",
    "format:check": "cargo fmt --all --check && prettier --check .",
    "lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "cargo test --workspace && turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  }
}
